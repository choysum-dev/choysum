{
  "name": "@choysum-dev/meta",
  "version": "0.0.0-20260626031438",
  "description": "Metadata and module management",
  "license": "Apache-2.0",
  "author": "Choysum Team",
  "type": "module",
  "main": "index.ts",
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vicons/material": "^0.13.0",
    "element-plus": "^2.14.1",
    "kysely": "^0.29.2",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "choysum": {
    "moduleName": "meta",
    "application": "meta",
    "category": "Platform/Metadata",
    "depends": [
      "core",
      "task"
    ],
    "cli": ">=0.0.0-0 <0.0.0",
    "entryPoints": {
      "service": "./service/index.ts",
      "web": "./web/index.ts"
    },
    "e2e": {
      "specs": "e2e",
      "scenarios": {
        "default": {
          "fixtures": [
            "e2e/fixtures/smoke.json"
          ]
        },
        "result-failed": {
          "extends": "default",
          "fixtures": []
        },
        "reload-failed": {
          "extends": "default",
          "fixtures": []
        },
        "lock-conflict": {
          "extends": "default",
          "fixtures": []
        }
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
