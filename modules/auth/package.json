{
  "name": "@choysum-dev/auth",
  "version": "0.0.0-20260626031438",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choysum-dev/choysum.git"
  },
  "description": "User authentication and management module",
  "license": "Apache-2.0",
  "author": "Choysum Team",
  "type": "module",
  "main": "index.ts",
  "peerDependencies": {
    "@vueuse/core": "^14.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "choysum": {
    "moduleName": "auth",
    "application": "auth",
    "category": "User/Authentication",
    "depends": [
      "core",
      "base",
      "meta",
      "document"
    ],
    "cli": ">=0.0.0-0 <0.0.0",
    "entryPoints": {
      "service": "./service/index.ts",
      "web": "./web/index.ts"
    },
    "data": [
      "data/bootstrap.json"
    ],
    "e2e": {
      "specs": "e2e",
      "scenarios": {
        "default": {
          "fixtures": [
            "e2e/fixtures/smoke.json"
          ]
        },
        "result-failed": {
          "extends": "default",
          "fixtures": []
        },
        "reload-failed": {
          "extends": "default",
          "fixtures": []
        },
        "lock-conflict": {
          "extends": "default",
          "fixtures": []
        }
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
